# Copy this file to deploy/.env. Never commit deploy/.env.
MYSQL_DATABASE=jenda_agent
MYSQL_USER=jenda
MYSQL_PASSWORD=replace-with-a-long-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-root-password
REDIS_PASSWORD=replace-with-a-long-redis-password

# Generate with: [Guid]::NewGuid().ToString("N") + [Guid]::NewGuid().ToString("N")
AGENT_AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AGENT_AUTH_TOKEN_TTL=15m
AGENT_AUTH_REFRESH_TOKEN_TTL=30d
AGENT_AUTH_LOGIN_MAX_FAILURES=5
AGENT_AUTH_LOGIN_FAILURE_WINDOW=15m
AGENT_AUTH_SMS_ENABLED=false
AGENT_AUTH_SMS_DEVELOPMENT_MODE=true
AGENT_AUTH_REFRESH_COOKIE_NAME=jenda_refresh
# Must be true behind HTTPS. Set false only when testing http://localhost directly.
AGENT_AUTH_REFRESH_COOKIE_SECURE=true
AGENT_AUTH_REFRESH_COOKIE_SAME_SITE=Lax
AGENT_AUTH_EXPOSE_REFRESH_TOKEN_IN_BODY=false
# Enable CAPTCHA in public environments. Redis is required when this is true.
AGENT_AUTH_CAPTCHA_ENABLED=true
# Comma-separated usernames permitted to change user plans via /api/v1/admin.
AGENT_AUTH_ADMIN_USERNAMES=replace-with-admin-username
AGENT_REDIS_ENABLED=true

# COS: required when deployed uploads and generated-image archival use Tencent COS.
AGENT_STORAGE_PROVIDER=cos
AGENT_STORAGE_COS_BUCKET=jenda-agent-1455545317
AGENT_STORAGE_COS_REGION=ap-shanghai
AGENT_STORAGE_COS_PREFIX=agent/
AGENT_STORAGE_COS_SECRET_ID=replace-with-cos-secret-id
AGENT_STORAGE_COS_SECRET_KEY=replace-with-cos-secret-key
AGENT_STORAGE_COS_STS_DURATION_SECONDS=1800

# Qwen text and OCR runtime.
AGENT_RUNTIME_MODEL_ENABLED=true
AGENT_RUNTIME_MODEL_BASE_URL=replace-with-openai-compatible-base-url
AGENT_RUNTIME_MODEL_API_KEY=replace-with-qwen-api-key
AGENT_RUNTIME_MODEL_NAME=qwen-plus

# Plan-Solve replan guardrails. An initial plan may be followed by this many replacement plans.
AGENT_PLAN_SOLVE_MAX_REPLANS=2
AGENT_PLAN_SOLVE_REPLAN_ON_FAILED_TASK=true
AGENT_PLAN_SOLVE_REPLAN_ON_SKIPPED_TOOL=true

# Qwen image generation and editing gateway.
AGENT_GATEWAY_IMAGE_GENERATE_ENABLED=true
AGENT_GATEWAY_IMAGE_GENERATE_ENDPOINT=replace-with-model-studio-multimodal-generation-endpoint
AGENT_GATEWAY_IMAGE_GENERATE_API_KEY=replace-with-qwen-api-key
AGENT_GATEWAY_IMAGE_EDIT_ENABLED=true
AGENT_GATEWAY_IMAGE_EDIT_ENDPOINT=replace-with-model-studio-multimodal-generation-endpoint
AGENT_GATEWAY_IMAGE_EDIT_API_KEY=replace-with-qwen-api-key
AGENT_GATEWAY_OCR_ENABLED=true

# Keep empty for port 80. Change to 8088 when port 80 is occupied locally.
HTTP_PORT=80
# Multi-model image provider. Keep qwen until SeedDream is configured and verified.
# Keep normalized tool routes available for qwen, SeedDream, and future providers.
AGENT_RUNTIME_TOOLS_IMAGE_GENERATE_ENABLED=true
AGENT_RUNTIME_TOOLS_IMAGE_EDIT_ENABLED=true
AGENT_IMAGE_PROVIDER_DEFAULT=qwen
AGENT_GATEWAY_SEEDDREAM_ENABLED=false
AGENT_GATEWAY_SEEDDREAM_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations
# Use the provisioned Volcano Ark endpoint ID, for example ep-xxxxxxxx.
AGENT_GATEWAY_SEEDDREAM_MODEL=
AGENT_GATEWAY_SEEDDREAM_API_KEY=
AGENT_GATEWAY_SEEDDREAM_SIZE=2K
AGENT_GATEWAY_SEEDDREAM_WATERMARK=true
AGENT_GATEWAY_SEEDDREAM_RESULT_HOST_SUFFIXES=.volces.com,.volcengine.com,.byteimg.com
AGENT_GATEWAY_SEEDDREAM_TIMEOUT=600s

# Native Volcano Ark SeedVR2 adapter. Use the provisioned SeedVR2 endpoint ID from the Ark console.
# The adapter signs COS inputs, calls the API server-side, and archives its output back to COS.
AGENT_GATEWAY_SEEDVR2_ENABLED=false
AGENT_GATEWAY_SEEDVR2_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations
AGENT_GATEWAY_SEEDVR2_MODEL=
AGENT_GATEWAY_SEEDVR2_API_KEY=
AGENT_GATEWAY_SEEDVR2_SIZE=4K
AGENT_GATEWAY_SEEDVR2_WATERMARK=false
AGENT_GATEWAY_SEEDVR2_RESULT_HOST_SUFFIXES=.volces.com,.volcengine.com
AGENT_GATEWAY_SEEDVR2_TIMEOUT=600s

# Native semantic layer adapter. Set this to the segmentation provider endpoint that accepts the documented
# normalized request: model, image_url, image_urls, prompt, num_layers, output_format, response_format.
# It may return layers, data.layers or output.layers; every layer is archived as a separate COS asset.
AGENT_GATEWAY_SEMANTIC_LAYER_ENABLED=false
AGENT_GATEWAY_SEMANTIC_LAYER_ENDPOINT=
AGENT_GATEWAY_SEMANTIC_LAYER_MODEL=
AGENT_GATEWAY_SEMANTIC_LAYER_API_KEY=
AGENT_GATEWAY_SEMANTIC_LAYER_OUTPUT_FORMAT=png
AGENT_GATEWAY_SEMANTIC_LAYER_RESULT_HOST_SUFFIXES=
AGENT_GATEWAY_SEMANTIC_LAYER_TIMEOUT=600s

# Google Gemini image models. Keep disabled until a Gemini API key is configured.
# Browser code never receives this key. NanoBanana input images are downloaded by the backend from COS and submitted as Base64.
AGENT_GATEWAY_GEMINI_ENABLED=false
AGENT_GATEWAY_GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/interactions
AGENT_GATEWAY_GEMINI_API_KEY=
AGENT_GATEWAY_GEMINI_NANO_BANANA2_MODEL=gemini-3.1-flash-image
AGENT_GATEWAY_GEMINI_NANO_BANANA_PRO_MODEL=gemini-3-pro-image
AGENT_GATEWAY_GEMINI_PRO_ENABLED=false
AGENT_GATEWAY_GEMINI_PRO_FALLBACK_TO_NANO_BANANA2=true
AGENT_GATEWAY_GEMINI_IMAGE_SIZE=2K
AGENT_GATEWAY_GEMINI_OUTPUT_MIME_TYPE=image/png
AGENT_GATEWAY_GEMINI_MAX_REFERENCE_IMAGES=6
AGENT_GATEWAY_GEMINI_MAX_REFERENCE_IMAGE_BYTES=8388608
AGENT_GATEWAY_GEMINI_TIMEOUT=600s
# Per authenticated user / day. Set to false only in a controlled development environment.
AGENT_IMAGE_QUOTA_ENABLED=true
AGENT_IMAGE_QUOTA_NANO_BANANA2_DAILY_LIMIT=20
AGENT_IMAGE_QUOTA_NANO_BANANA_PRO_DAILY_LIMIT=3
# Real image processing workflows. Each endpoint receives JSON with: model, prompt, image_url,
# image_urls, parameters, response_format. It must return image_url/url or base64/b64_json.
# Image upscale: configure a provider endpoint that supports super-resolution, not a text-to-image endpoint.
AGENT_TOOLS_IMAGE_UPSCALE_ENABLED=false
AGENT_TOOLS_IMAGE_UPSCALE_ENDPOINT=
AGENT_TOOLS_IMAGE_UPSCALE_API_KEY=
AGENT_TOOLS_IMAGE_UPSCALE_MODEL=
AGENT_TOOLS_IMAGE_UPSCALE_MODE=edit
AGENT_TOOLS_IMAGE_UPSCALE_RESULT_HOST_SUFFIXES=
AGENT_TOOLS_IMAGE_UPSCALE_TIMEOUT=600s

# SeedVR2: configure the provider-specific SeedVR2 endpoint and model ID.
AGENT_TOOLS_SEEDVR2_ENABLED=false
AGENT_TOOLS_SEEDVR2_ENDPOINT=
AGENT_TOOLS_SEEDVR2_API_KEY=
AGENT_TOOLS_SEEDVR2_MODEL=
AGENT_TOOLS_SEEDVR2_MODE=edit
AGENT_TOOLS_SEEDVR2_RESULT_HOST_SUFFIXES=
AGENT_TOOLS_SEEDVR2_TIMEOUT=600s
# PromptOpAgent RAG. Qdrant remains internal to Docker; do not publish port 6333.
AGENT_RAG_ENABLED=true
AGENT_RAG_QDRANT_API_KEY=replace-with-a-separate-48-character-random-key
AGENT_RAG_COLLECTION=jenda_prompt_knowledge_v1
# Empty values reuse AGENT_RUNTIME_MODEL_BASE_URL and AGENT_RUNTIME_MODEL_API_KEY.
AGENT_RAG_EMBEDDING_BASE_URL=
AGENT_RAG_EMBEDDING_API_KEY=
AGENT_RAG_EMBEDDING_MODEL=text-embedding-v4
AGENT_RAG_EMBEDDING_DIMENSIONS=1024
# Controlled ReAct limits. PARALLEL accepts only independent tools and is capped at two calls.
AGENT_REACT_MAX_STEPS=6
AGENT_REACT_TIMEOUT=8m
AGENT_REACT_REPEATED_TOOL_LIMIT=2
AGENT_REACT_MAX_PARALLEL_ACTIONS=2
AGENT_REACT_MAX_TOOL_CALLS=8
AGENT_REACT_MAX_COST_UNITS=12
