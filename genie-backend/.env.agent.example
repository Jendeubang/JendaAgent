# Do not commit actual credentials. Spring Boot maps these names to agent.runtime.*.

# Qwen via DashScope OpenAI-compatible API
AGENT_RUNTIME_MODEL_ENABLED=true
AGENT_RUNTIME_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_RUNTIME_MODEL_API_KEY=replace-with-your-dashscope-key
AGENT_RUNTIME_MODEL_MODEL=qwen-plus
AGENT_RUNTIME_MODEL_TEMPERATURE=0.2
AGENT_RUNTIME_MODEL_TIMEOUT=90s

# Generic OCR HTTP endpoint. Request JSON: prompt, image_urls, task_type.
AGENT_RUNTIME_TOOLS_OCR_ENABLED=false
AGENT_RUNTIME_TOOLS_OCR_URL=https://provider.example.com/v1/ocr
AGENT_RUNTIME_TOOLS_OCR_API_KEY=replace-with-ocr-key

# Generic image generation endpoint.
AGENT_RUNTIME_TOOLS_IMAGE_GENERATE_ENABLED=false
AGENT_RUNTIME_TOOLS_IMAGE_GENERATE_URL=https://provider.example.com/v1/images/generations
AGENT_RUNTIME_TOOLS_IMAGE_GENERATE_API_KEY=replace-with-image-key

# Generic image editing endpoint.
AGENT_RUNTIME_TOOLS_IMAGE_EDIT_ENABLED=false
AGENT_RUNTIME_TOOLS_IMAGE_EDIT_URL=https://provider.example.com/v1/images/edits
AGENT_RUNTIME_TOOLS_IMAGE_EDIT_API_KEY=replace-with-image-key
