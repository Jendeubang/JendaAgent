{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jenda structured Plan-Solve plan",
  "type": "object",
  "required": ["version", "goal", "tasks"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "goal": {"type": "string", "minLength": 1, "maxLength": 2000},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "title", "kind", "prompt", "dependsOn", "parallelGroup", "maxAttempts", "skipWhen", "requiresConfirmation"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 160},
          "kind": {"enum": ["OCR", "IMAGE_GENERATE", "IMAGE_EDIT", "HUMAN_CONFIRMATION"]},
          "prompt": {"type": "string", "maxLength": 8000},
          "dependsOn": {"type": "array", "items": {"type": "string"}, "maxItems": 7},
          "parallelGroup": {"type": "string", "maxLength": 64},
          "maxAttempts": {"type": "integer", "minimum": 1, "maximum": 3},
          "skipWhen": {"enum": ["never", "no_input_image", "previous_failed", "tool_unavailable"]},
          "requiresConfirmation": {"type": "boolean"},
          "confirmationMessage": {"type": "string", "maxLength": 1000}
        }
      }
    }
  }
}
